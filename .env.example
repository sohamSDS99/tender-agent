# =============================================================================
# TENDER AGENT — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# =============================================================================

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VOYAGE_API_KEY=
# Supabase direct connection (port 5432) — required for LangGraph checkpointer
# Get from: Supabase dashboard → Project Settings → Database → Connection string → URI
# Format: postgresql+psycopg://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
# Supabase project credentials (optional — for REST API / admin tasks)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=
SLACK_MANAGER_CHANNEL_ID=
IMAP_SERVER=
IMAP_EMAIL=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SUBMISSION_EMAIL_TO=
SUBMISSION_API_ENDPOINT=
SUBMISSION_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tender-agent
TENDER_SCORE_THRESHOLD=60
SLACK_TIMEOUT_HOURS=48
MAX_ASSEMBLY_RETRIES=3
DRY_RUN=true

# --- Government Procurement APIs ---
# SAM.gov (US Federal Tenders) — free, register at https://sam.gov
SAM_GOV_API_KEY=

# Bright Data SERP proxy (Google fallback when APIs return zero)
BRIGHTDATA_SERP_PROXY=

# Nexus AMS↔bridge bearer auth (leave empty for dev / open access).
# When set on both sides, the bridge sends "Authorization: Bearer <value>"
# on every search-jobs / discovered-tenders / tasks call.
NEXUS_AGENT_API_KEY=

# Chile MercadoPublico ticket — free, request at
# https://api.mercadopublico.cl/ (Participa → Solicitar Ticket).
# They email you back a long string; paste it here.
CHILE_MP_TICKET=

# Paraguay DNCP OAuth credentials — free, register a developer
# account at https://contrataciones.gov.py/datos/adm/login then
# create an application under "Mis Aplicaciones" to get client_id +
# client_secret.
PARAGUAY_DNCP_CLIENT_ID=
PARAGUAY_DNCP_CLIENT_SECRET=