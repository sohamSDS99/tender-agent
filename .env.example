# =============================================================================
# TENDER AGENT — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# =============================================================================

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VOYAGE_API_KEY=
# Supabase direct connection (port 5432) — required for LangGraph checkpointer
# Get from: Supabase dashboard → Project Settings → Database → Connection string → URI
# Format: postgresql+psycopg://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
# Supabase project credentials (optional — for REST API / admin tasks)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=
SLACK_MANAGER_CHANNEL_ID=
IMAP_SERVER=
IMAP_EMAIL=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SUBMISSION_EMAIL_TO=
SUBMISSION_API_ENDPOINT=
SUBMISSION_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tender-agent
TENDER_SCORE_THRESHOLD=60
SLACK_TIMEOUT_HOURS=48
MAX_ASSEMBLY_RETRIES=3
DRY_RUN=true
# --- Nexus AMS integration -------------------------------------------------
# Base URL of the AMS. Defaults to http://localhost:3000 when unset.
NEXUS_AMS_URL=

# Credential for every bridge → AMS call (P0.0).
#
# Must be IDENTICAL to NEXUS_AGENT_API_KEY on the AMS service. The AMS currently
# falls open when its copy is unset; once that fall-open is removed, a bridge
# without this key gets 401 on /search, /context, /prompt and file downloads.
# Set it on BOTH services before the AMS ships its fail-closed change.
NEXUS_AGENT_API_KEY=
